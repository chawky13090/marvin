# Modèle de configuration SearXNG pour Marvin.
# start-searxng.ps1 copie ce fichier vers settings.yml (gitignoré — contient un secret
# généré localement) et remplace CHANGE_ME_AUTO_GENERATED par une clé aléatoire au
# premier lancement. Ne pas éditer settings.yml directement si tu veux que ce modèle
# reste la source de vérité versionnée.
use_default_settings:
  engines:
    # Pool explicite et reproductible. SearXNG ne chargera pas silencieusement
    # de nouveaux moteurs lors d'une mise à jour de son image.
    keep_only:
      - bing
      - bing images
      - bing news
      - bing videos
      - google cse
      - google cse images
      - google news
      - startpage
      - qwant
      - mojeek
      - yahoo
      - dogpile
      - presearch
      - yandex
      - baidu
      - naver
      - seznam
      - wiby
      - wikipedia
      - wikidata
      - github
      - stackoverflow
      - arxiv
      - semantic scholar
      - openalex
      - pubmed
      - crossref
      - openverse
      - youtube
      - vimeo
      - reddit

general:
  instance_name: "Marvin SearXNG"

search:
  # 'json' est désactivé par défaut sur une install SearXNG standard — indispensable
  # pour que Marvin (execute_web_search -> provider searxng) puisse parser les résultats.
  formats:
    - html
    - json

server:
  secret_key: "CHANGE_ME_AUTO_GENERATED"
  limiter: false   # pas de Redis nécessaire pour un usage local mono-utilisateur
  image_proxy: false

outgoing:
  # Le délai historique de 3 s éliminait des moteurs encore sains. Ce budget
  # reste borné afin qu'un moteur lent ne bloque pas toute la métarecherche.
  request_timeout: 6.0
  max_request_timeout: 12.0
  pool_connections: 100
  pool_maxsize: 30
  enable_http2: true

# Marvin n'utilise que SearXNG. Ce pool couvre recherche générale, actualités,
# images, vidéos, code et publications scientifiques. Brave et DuckDuckGo
# restent exclus conformément au choix opérateur.
engines:
  - name: bing
    disabled: false
  - name: bing images
    disabled: false
  - name: bing news
    disabled: false
  - name: bing videos
    disabled: false
  - name: google cse
    disabled: false
  - name: google cse images
    disabled: false
  - name: google news
    disabled: false
  - name: startpage
    disabled: false
  - name: qwant
    disabled: false
  - name: mojeek
    disabled: false
  - name: yahoo
    disabled: false
  - name: dogpile
    disabled: false
  - name: presearch
    disabled: false
  - name: yandex
    disabled: false
  - name: baidu
    disabled: false
  - name: naver
    disabled: false
  - name: seznam
    disabled: false
  - name: wiby
    disabled: false
  - name: wikipedia
    disabled: false
  - name: wikidata
    disabled: false
  - name: github
    disabled: false
  - name: stackoverflow
    disabled: false
  - name: arxiv
    disabled: false
  - name: semantic scholar
    disabled: false
  - name: openalex
    disabled: false
  - name: pubmed
    disabled: false
  - name: crossref
    disabled: false
  - name: openverse
    disabled: false
  - name: youtube
    disabled: false
  - name: vimeo
    disabled: false
  - name: reddit
    disabled: false

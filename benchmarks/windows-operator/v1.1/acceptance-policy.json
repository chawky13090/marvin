{
  "schema": "marvin.windows-operator-acceptance/1.1",
  "status": "locked_before_baseline",
  "supersedes": "../v1/acceptance-policy.json",
  "primary_metric": "verified_end_to_end_success_rate",
  "context_precondition": {
    "minimum_tokens": 32768,
    "recommended_tokens": 65536,
    "evidence_required": true,
    "local_evidence": "api_ps_allocated_context",
    "local_runtime_residency_required": true,
    "cloud_evidence": "cloud_provider_declared_max",
    "cloud_runtime_allocation": "unavailable",
    "cloud_long_context_behavioral_test_required": true,
    "capture_process_environment_is_not_runtime_evidence": true
  },
  "outcomes": {
    "generalized": {"all": [
      {"metric": "verified_end_to_end_success_rate", "operator": ">=", "value": 0.85},
      {"any": [
        {"metric": "success_rate_gain_points", "operator": ">=", "value": 0.20},
        {"metric": "failure_rate_reduction", "operator": ">=", "value": 0.50}
      ]},
      {"metric": "false_success_count", "operator": "==", "value": 0},
      {"metric": "functional_regression_count", "operator": "==", "value": 0},
      {"metric": "intelligence_regression_count", "operator": "==", "value": 0},
      {"metric": "reversible_rollback_success_rate", "operator": "==", "value": 1.0}
    ]},
    "restricted": {
      "all": [
        {"metric": "success_rate_gain_points", "operator": ">=", "value": 0.20},
        {"metric": "verified_end_to_end_success_rate", "operator": "<", "value": 0.85},
        {"metric": "false_success_count", "operator": "==", "value": 0},
        {"metric": "functional_regression_count", "operator": "==", "value": 0},
        {"metric": "intelligence_regression_count", "operator": "==", "value": 0}
      ],
      "family_activation": {"verified_success_rate": 0.85, "false_success_count": 0, "functional_regression_count": 0, "intelligence_regression_count": 0}
    },
    "rollback": {"any": [
      {"metric": "false_success_count", "operator": ">", "value": 0},
      {"metric": "functional_regression_count", "operator": ">", "value": 0},
      {"metric": "intelligence_regression_count", "operator": ">", "value": 0},
      {"all": [
        {"metric": "success_rate_gain_points", "operator": "<", "value": 0.20},
        {"metric": "failure_rate_reduction", "operator": "<", "value": 0.50}
      ]}
    ]}
  },
  "intelligence_preservation": {
    "definition": "Régression si une capacité de baseline échoue, si le holdout baisse, si un modèle moins apte est choisi sans contrainte, si Council perd une famille, si le catalogue diminue, ou si la rétention Cloud mesurée baisse.",
    "target_regression_count": 0,
    "cloud_provider_declared_max_must_not_decrease": true,
    "cloud_client_context_override_count": 0,
    "cloud_behavioral_retention_must_not_regress": true,
    "council_distinct_model_families_minimum": 5,
    "tool_catalog_may_shrink": false,
    "independent_holdout_quality_oracle_required": true
  },
  "efficiency_gates": {"median_step_ratio_to_baseline_max": 0.75, "confirmation_ratio_to_baseline_max_when_baseline_above_one": 0.70, "confirmation_increase_allowed_when_baseline_at_most_one": 0},
  "redundant_confirmation": {
    "definition": "Toute confirmation supplémentaire alors qu'un mandat actif couvre déjà la même mission, machine, classe de risque, cible et effets annoncés, sans nouvelle frontière légitime.",
    "target_count": 0,
    "legitimate_new_boundaries": ["scope_change", "risk_class_change", "new_target", "new_external_recipient", "privilege_escalation", "new_irreversible_effect", "unsaved_data_loss_dialog", "mandate_expired", "mandate_revoked"]
  },
  "statistical_gates": {"engineering_live_runs": 75, "engineering_false_success_count": 0, "general_release_live_runs": 300, "general_release_false_success_count": 0, "reported_confidence_level": 0.95, "report_variance": true}
}

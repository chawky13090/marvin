    "desktop.visual_interaction": {
      "family": "desktop_observation",
      "rationale": "Les intentions exigent observation, UIA, capture, clic ou saisie sur une interface réellement visible.",
      "accepted": [
        {
          "name": "computer_control",
          "action": "observe|screenshot|click|type|focus|verify",
          "role": "terminal",
          "catalog_description": "Contrôle exclusivement visuel du PC et du navigateur lorsque l'action exige une capture, un élément UIA, un clic, une saisie ou une navigation interactive. Pour les processus, services, logiciels, applications et fichiers, utiliser windows_task. Le LLM conduit librement la boucle Observer → Décider → Agir → Vérifier → Corriger. observe renvoie une capture et des element_ref facultatives. Utilise les coordonnées de frame_id lorsque l'UIA ne suffit pas. action=commit est obligatoire pour le clic final qui réserve, achète, publie ou envoie un formulaire : il demande toujours un clic utilisateur. Pour « ouvre [navigateur] et va sur [site] » : utilise action=open avec target=navigateur ET url=le site, EN UN SEUL APPEL — ne jamais enchaîner action=navigate ensuite, qui pilote un navigateur headless séparé et n'affecte jamais la fenêtre visible ouverte par open.",
          "catalog_source_line": 4055,
          "catalog_spec_sha256": "b9696990546acbf5e1c078798b1d8bf39798bc06a6c9854cdfd29f051a1e3915"
        },
        {
          "name": "pc_gui_read",
          "action": null,
          "role": "evidence",
          "catalog_description": "Lit l'arbre des éléments cliquables (boutons/champs/menus/listes) d'une fenêtre Windows via UI Automation — PAS une capture d'écran, une lecture structurée 100% locale. Utilise ceci AVANT tout pc_gui_click/pc_gui_type pour obtenir les identifiants réels des éléments (jamais deviner un automation_id). Sans 'window', lit la fenêtre au premier plan. Échoue proprement si la fenêtre est élevée (admin) — inaccessible depuis ce process.",
          "catalog_source_line": 3241,
          "catalog_spec_sha256": "7483326eaef1b3e931a3bac1415834013e97f53b86471c11fa3c711a80f4ffa5"
        }
      ],
      "explicit_rejections": [
        "windows_task"
      ]
    },

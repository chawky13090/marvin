# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Données sensibles — base SQLite, clés Google, credentials, compétences personnelles,
# journaux d'audit, backups. NE JAMAIS versionner (contient des secrets réels).
data/
backend/data/

# Vidéos/images générées localement (volumineux, non reproductible utile en repo)
generated_videos/
backend/generated_videos/

# Logs Marvin
*.log

# Cache local d'upload Drive (fichiers temporaires, pas du code)
.tmp.driveupload/

# Scratch/debug (dumps SSE, script de test ad-hoc, capture d'écran) — pas du code projet
last-event.json
streamText.txt
test_ai.js
_mining_ui.png

# SearXNG (recherche web auto-hébergée, v2.162) — settings.yml généré localement contient
# une clé secrète propre à la machine (start-searxng.ps1 la génère depuis settings.yml.example).
docker/searxng/settings.yml
